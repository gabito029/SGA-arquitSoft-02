# Variables de entorno del SGA (incremento 001).
# Copiar a .env (que NUNCA se versiona) y reemplazar los valores de ejemplo.
#   cp .env.example .env
#   python backend/scripts/generar_clave_firma.py >> .env

# --- PostgreSQL (Docker Compose los usa para crear la base de datos) ---
POSTGRES_USER=sga
POSTGRES_PASSWORD=cambiar-esta-contrasena
POSTGRES_DB=sga

# Conexión desde la máquina local (desarrollo sin contenedores y pruebas).
# Dentro de Docker Compose, la API usa el host "db" (ver docker-compose.yml).
DATABASE_URL=postgresql+psycopg://sga:cambiar-esta-contrasena@127.0.0.1:5432/sga
DATABASE_URL_TEST=postgresql+psycopg://sga:cambiar-esta-contrasena@127.0.0.1:5432/sga_test

# --- JWT (ADR-006) ---
# Generar un secreto largo, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=reemplazar-por-un-secreto-largo-y-aleatorio
JWT_MINUTOS=60

# --- Firma digital Ed25519 (ADR-004) ---
# Las genera backend/scripts/generar_clave_firma.py; no dejar valores reales aquí.
FIRMA_CLAVE_PRIVADA=
FIRMA_CLAVE_ID=

# --- Reglas de negocio (ADR-008) ---
UMBRAL_MONTO_ALTO=50000

# --- Caché del catálogo (research §7). false la desactiva para medir EQ-04 sin caché ---
CATALOGO_CACHE_ACTIVA=true

# --- Datos de prueba (seeds, RC13) ---
CONTRASENA_DEMO=cambiar-esta-contrasena-demo
